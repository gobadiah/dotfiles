#!/usr/bin/env bash
set -euo pipefail

CHEZMOI_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
# Absolute path: launchd runs this with a minimal PATH that excludes
# /opt/homebrew/bin, so a bare `chezmoi` would fail every night.
CHEZMOI="/opt/homebrew/bin/chezmoi"

# Pull changes made directly in $HOME back into the source dir. Without this,
# live edits never reach git — only changes already staged into source do.
# The target wins on conflict: edits in $HOME are the ones made without
# thinking about chezmoi, whereas source edits are deliberate and inert until
# `chezmoi apply`. Templates are never overwritten, so secrets stay secret.
# Bounded: re-add renders templates to compute target state, and several of
# those call `op`. If 1Password is locked at 23:00 that could block forever,
# so cap it and fall through to committing whatever is already in source.
if ! /opt/homebrew/bin/timeout 300 "$CHEZMOI" re-add; then
  echo "chezmoi-autocommit: re-add failed or timed out, committing source-only changes" >&2
fi

# No-op if clean. Avoids `| grep -q`: under pipefail, grep exits on the first
# match and the writer can die of SIGPIPE, failing the pipeline.
if [ -z "$(git -C "$CHEZMOI_DIR" status --porcelain)" ]; then
  exit 0
fi

# Stage everything
git -C "$CHEZMOI_DIR" add -A

# Get the staged diff for the commit message
DIFF=$(git -C "$CHEZMOI_DIR" diff --cached --stat && echo "---" && git -C "$CHEZMOI_DIR" diff --cached)

PROMPT="Write a concise git commit message for these chezmoi dotfiles changes.
Output ONLY the commit message — one line, imperative mood, no period, no quotes, no explanation.

$DIFF"

MESSAGE=$(printf '%s' "$PROMPT" | "$HOME/.local/bin/claude" -p --output-format text 2>/dev/null)

if [[ -z "$MESSAGE" ]]; then
  echo "chezmoi-autocommit: claude returned empty message, aborting" >&2
  git -C "$CHEZMOI_DIR" reset HEAD 2>/dev/null || true
  exit 1
fi

git -C "$CHEZMOI_DIR" commit -m "$MESSAGE"
git -C "$CHEZMOI_DIR" push
echo "chezmoi-autocommit: committed — $MESSAGE"
